<Project Sdk="Microsoft.NET.Sdk">
  <!-- Set my Defaults on JB Framework. 1.7: dotnet build -c Release (or JBFramework/tools/jbmod BetterWorkbenchDefaults build).
       1.6 stays frozen (Source/Frozen16.sha256): the 1.6 DLL in 1.6/Assemblies is the Workshop state of 24.11.2026 and is never rebuilt. -->
  <PropertyGroup>
    <AssemblyName>BetterWorkbenchDefaults</AssemblyName>
    <RootNamespace>BetterWorkbenchDefaults</RootNamespace>
  </PropertyGroup>
  <Import Project="$(MSBuildProjectDirectory)/../../JBFramework/build/JBMod.props" />
  <ItemGroup>
    <Compile Remove="Tests/**" />
  </ItemGroup>
</Project>
