<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone proof of Source/Lib (no game needed): file format, 1.x migration, share strings.
       Run: dotnet run -c Release (from this folder). Not part of the mod build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Lib/*.cs" Link="Lib/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
